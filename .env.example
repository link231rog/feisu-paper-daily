# ==============================================================================
# Feishu Paper Daily & DeepResearch — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Feishu Open Platform (飞书开放平台)
# ------------------------------------------------------------------------------
FEISHU_APP_ID=cli_a1b2c3d4e5f6
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_WIKI_SPACE_ID=7480000000000000000
FEISHU_DAILY_PARENT_NODE_TOKEN=your_daily_parent_node_token
FEISHU_CONSOLE_NODE_TOKEN=your_console_node_token
FEISHU_NOTES_PARENT_NODE_TOKEN=your_notes_parent_node_token

# Optional Feishu Wiki Nodes
FEISHU_MASTER_INDEX_NODE_TOKEN=
FEISHU_TAG_GRAPH_NODE_TOKEN=
FEISHU_ENGINEERING_PARENT_NODE_TOKEN=
FEISHU_IDEA_PARENT_NODE_TOKEN=
FEISHU_EXPERIMENT_PARENT_NODE_TOKEN=
FEISHU_SYNTHESIS_PARENT_NODE_TOKEN=

# ------------------------------------------------------------------------------
# 2. LLM Reasoning & Annotation (OpenRouter / OpenAI compatible)
# ------------------------------------------------------------------------------
# Multiple keys can be comma-separated for automatic pool rotation and fallback
LLM_API_KEYS=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_BACKUP_MODEL=xingchen-agi/xing4.0-29b-a4b:free

# ------------------------------------------------------------------------------
# 3. Academic Translation
# ------------------------------------------------------------------------------
TRANSLATION_ENABLED=true
TRANSLATION_API_BASE=https://openrouter.ai/api/v1
TRANSLATION_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSLATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
TRANSLATION_BACKUP_MODEL=xingchen-agi/xing4.0-29b-a4b:free
TRANSLATION_LAYOUT=quote
TRANSLATION_BATCH_SIZE=5

# ------------------------------------------------------------------------------
# 4. Email Notification (SMTP SSL)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
SENDER=your_email@qq.com
RECEIVER=your_email@qq.com
SENDER_PASSWORD=your_smtp_authorization_code
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# ------------------------------------------------------------------------------
# 5. WeChat Official Account Draft Push (微信公众号草稿箱) [Optional]
# ------------------------------------------------------------------------------
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_THUMB_MEDIA_ID=
WECHAT_AUTHOR=Feishu Paper Daily
WECHAT_CONTENT_SOURCE_URL=

# ------------------------------------------------------------------------------
# 6. Academic Data Sources [Optional]
# ------------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=
ZOTERO_ID=
ZOTERO_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
