# ==============================================================================
# Paper Daily Environment Configuration Template (.env.example)
# ==============================================================================

# --- LLM API Configuration (OpenAI-compatible) ---
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_BACKUP_MODEL=xingchen-agi/xing4.0-29b-a4b:free
LLM_API_KEYS=sk-xxx

# --- Academic Translation Configuration (Optional) ---
# Engine: "web" (free Bing/Google auto-fallback, no API key needed) | "bing" | "google" | "llm"
TRANSLATION_ENABLED=true
TRANSLATION_ENGINE=web
TRANSLATION_CONCURRENCY=5
TRANSLATION_LAYOUT=quote
TRANSLATION_BATCH_SIZE=5
# Optional LLM translation fallback settings
TRANSLATION_API_BASE=https://openrouter.ai/api/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
TRANSLATION_BACKUP_MODEL=xingchen-agi/xing4.0-29b-a4b:free

# --- Visual Framework Diagram & Academic Poster (Optional) ---
POSTER_ENABLED=false
POSTER_API_BASE=https://sub.umapis.com/v1
POSTER_API_KEY=
POSTER_MODEL=gpt-image-2.5-sunburst
POSTER_PROXY_URL=

# --- Feishu (Lark) Delivery & Console ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_SPACE_ID=
FEISHU_DAILY_PARENT_NODE_TOKEN=
FEISHU_NOTES_PARENT_NODE_TOKEN=
FEISHU_CONSOLE_NODE_TOKEN=
FEISHU_MASTER_INDEX_NODE_TOKEN=
FEISHU_TAG_GRAPH_NODE_TOKEN=
FEISHU_ENGINEERING_PARENT_NODE_TOKEN=

# --- Email Delivery (SMTP SSL) ---
EMAIL_ENABLED=false
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SENDER=
SENDER_PASSWORD=
RECEIVER=

# --- WeChat Official Account (微信公众号) ---
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=Paper Daily
WECHAT_COVER_PATH=
WECHAT_THUMB_MEDIA_ID=
WECHAT_CONTENT_SOURCE_URL=

# --- Telegram Bot Delivery ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Third-party Literature Libraries ---
SEMANTIC_SCHOLAR_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
ZOTERO_ID=
ZOTERO_KEY=
